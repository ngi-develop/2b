# Copy to .env and adjust.

PORT=5000
NODE_ENV=development

# Leave MONGODB_URI empty to boot an in-memory MongoDB (development only —
# data is lost on restart). Set it to run against a real database:
#   docker compose up -d      ->  mongodb://127.0.0.1:27017/2b_location
MONGODB_URI=

# Change this. Tokens signed with the fallback are rejected when NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Seeded administrator (used by npm run seed).
SEED_ADMIN_EMAIL=admin@2blocation.ma
SEED_ADMIN_PASSWORD=Change-me-2026
