# Copy to .env before `docker compose up`. Compose reads this file
# automatically; it is gitignored and must never be committed.

# Port the site is published on. Point your reverse proxy here, or open it
# directly. The container always listens on 5000 internally.
APP_PORT=8080

# Required. Generate one and keep it stable — changing it logs everyone out.
#   openssl rand -base64 48
JWT_SECRET=

JWT_EXPIRES_IN=12h

# The first administrator, created by `npm run seed -- --keep`.
# Change the password before the first deploy, and again after logging in.
SEED_ADMIN_EMAIL=admin@2blocation.ma
SEED_ADMIN_PASSWORD=

# Leave empty for a same-origin deployment. Only set this if the front end
# is served from a different host than the API.
CORS_ORIGIN=
